// ===== MÉTRICAS (Prometheus) =====
prometheus.scrape "microservices" {
  targets = [
    { __address__ = "host.docker.internal:3000" }, // auth-ms local
    { __address__ = "host.docker.internal:3001" }, // orders-ms local
  ]
  forward_to = [prometheus.remote_write.grafana.receiver]
}

prometheus.remote_write "grafana" {
  endpoint {
    url = "https://prometheus-prod-<region>.grafana.net/api/prom/push"
    basic_auth {
      username = "${GRAFANA_INSTANCE_ID}"
      password = "${GRAFANA_API_KEY}"
    }
  }
}

// ===== TRAZAS (OTel → Tempo) =====
otelcol.receiver.otlp "from_apps" {
  protocols {
    http {
      endpoint = "0.0.0.0:4318"
    }
  }
  output {
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [tempo.write.grafana.input]
  }
}

tempo.write "grafana" {
  endpoint {
    url = "https://tempo-prod-<region>.grafana.net/otlp/v1/traces"
    basic_auth {
      username = "${GRAFANA_INSTANCE_ID}"
      password = "${GRAFANA_API_KEY}"
    }
  }
}

